[sub_resource type="GDScript" id="GDScript_aj8qc"]
script/source = "extends LineEdit

signal text_cancelled
signal focus_exited_without_cancel

var is_just_cancel: bool = false

func _gui_input(event: InputEvent) -> void:
	if !visible: return
	is_just_cancel = false
	
	if event is InputEventKey:
		if (event as InputEventKey).keycode == KEY_ESCAPE && event.pressed:
			is_just_cancel = true
			text_cancelled.emit()
			get_viewport().set_input_as_handled()

func _on_focus_exited() -> void:
	if !is_just_cancel: focus_exited_without_cancel.emit()
"

