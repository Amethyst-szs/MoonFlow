[sub_resource type="GDScript" id="GDScript_gpx5i"]
script/source = "extends RichTextLabel

func _ready() -> void:
	material = material.duplicate()

func _process(_delta: float) -> void:
	var content_scale_factor: float = 1.0 / get_window().content_scale_factor
	var window_size: Vector2 = Vector2(get_window().size) * content_scale_factor
	
	var content_pos: Vector2 = global_position / window_size
	var content_size: Vector2 = get_global_rect().size / window_size
	(material as ShaderMaterial).set_shader_parameter(\"rect_global_pos\", content_pos)
	(material as ShaderMaterial).set_shader_parameter(\"rect_size\", content_size)

func set_shader_colors(top: Color, bottom: Color) -> void:
	(material as ShaderMaterial).set_shader_parameter(\"first_color\", top)
	(material as ShaderMaterial).set_shader_parameter(\"second_color\", bottom)
"

