[sub_resource type="GDScript" id="GDScript_frp4o"]
script/source = "extends MenuButton

signal toggle_filter_modified(state: bool)
signal toggle_filter_custom(state: bool)

func _ready() -> void:
	get_popup().hide_on_checkable_item_selection = false
	get_popup().id_pressed.connect(_on_menu_id_checked)

func _on_menu_id_checked(id: int) -> void:
	var idx: int = get_popup().get_item_index(id)
	var old_state: bool = get_popup().is_item_checked(idx)
	get_popup().set_item_checked(idx, !old_state)
	
	match(id):
		0: toggle_filter_modified.emit(!old_state)
		1: toggle_filter_custom.emit(!old_state)

func _on_toggled(_toggled_on: bool) -> void:
	var is_any_item_checked: bool = false
	for i in range(get_popup().item_count):
		if get_popup().is_item_checked(i):
			is_any_item_checked = true
			break
	
	if is_any_item_checked:
		set_pressed_no_signal(true)
"

